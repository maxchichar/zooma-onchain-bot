# Copy this to .env for local dev. In production (Render), set these as
# dashboard environment variables instead — never commit real values.

HELIUS_API_KEY=
# Shared secret you invent yourself. Helius echoes it back in the
# Authorization header of every webhook POST so you can verify the
# request actually came from Helius and not a random script kiddie.
HELIUS_WEBHOOK_SECRET=

SUPABASE_URL=
# Use the SERVICE ROLE key (not anon) since this runs server-side only.
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any random string you invent — enables slash commands (/watch, /list,
# etc). Telegram echoes this back on every command so the server can
# verify it. Use a DIFFERENT value than HELIUS_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# How many distinct tracked wallets must buy the same token within
# ACCUMULATION_WINDOW_MINUTES before an ACCUMULATION signal fires.
ACCUMULATION_THRESHOLD=3
ACCUMULATION_WINDOW_MINUTES=120

# Don't re-fire the same (token, signal_type) more often than this.
SIGNAL_COOLDOWN_HOURS=6

# Optional — JEV (TypeSafe) classification on top of the rule. If unset,
# signals still fire and notify, just without the JEV read.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional — LLM explanation layer. If unset, alerts fall back to a plain
# templated message instead of a written explanation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Discovery scaling ----------
# How many NEW wallets discovery may add in a single run. Raised from the
# original conservative default (5) — this is a pure pacing knob, safe to
# raise freely as long as MAX_TRACKED_WALLETS below is sized sensibly.
MAX_NEW_WALLETS_PER_RUN=25

# The real ceiling: total tracked wallets, ever. Helius's free tier is 1M
# credits/month, 1 credit per webhook event delivered. Rough math — if
# your tracked wallets average ~5 swaps/day between them, 1M credits/month
# supports roughly 6,000-7,000 wallets before you start silently losing
# events (Helius doesn't error loudly — deliveries just stop once credits
# run out). 5000 is a reasonable starting ceiling; watch your Helius
# dashboard usage for a week after raising it before raising it again.
MAX_TRACKED_WALLETS=5000

# How often the ALWAYS-ON SERVER runs a discovery pass, in minutes. This
# replaced the separate GitHub Actions cron so frequency isn't limited by
# GitHub's free-minute budget. 5 is aggressive but fine — runDiscoveryOnce
# is a no-op once MAX_TRACKED_WALLETS is hit, so there's no real downside
# to a short interval other than more frequent Helius RPC calls.
DISCOVERY_INTERVAL_MINUTES=5

# A candidate holder must own this fraction of the token's top-20 holder
# sample to be considered (guards against adding dust-balance addresses).
# Lower = more candidates considered = more noise likely too.
DISCOVERY_MIN_HOLDER_FRACTION=0.005

DISCOVERY_LOOKBACK_HOURS=24

# ---------- Research module (meme coins, NFTs) ----------
# X's own API has no free read tier as of Feb 2026 — this uses free
# substitutes instead. See README for why.

# Free, no key needed for DexScreener (meme coin discovery + real
# liquidity/volume checks).

# Optional. Free-tier key from lunarcrush.com — adds a social-attention
# score (aggregated from X/Reddit/etc, not raw posts) to meme coin
# candidates. Skipped gracefully if unset.
LUNARCRUSH_API_KEY=

# Real filters — a token must clear BOTH to surface at all, regardless of
# how "boosted" or socially hyped it looks. This is what stops "someone
# paid for promotion" from being mistaken for "worth a look."
RESEARCH_MIN_LIQUIDITY_USD=5000
RESEARCH_MIN_VOLUME_24H_USD=10000
MEME_COIN_COOLDOWN_HOURS=12
MAX_MEME_CANDIDATES_PER_RUN=10

# NFTs: how many collections to sample per run (Magic Eden, free, no key)
# and how big a volume jump vs. the prior scan counts as worth flagging.
NFT_SAMPLE_SIZE=40
NFT_VOLUME_SPIKE_PCT=25
NFT_COOLDOWN_HOURS=24

# ---------- Rug risk checks (meme coins) ----------
# How many pages (100 tx each) to page back when approximating a token's
# deployer, and when scanning that deployer's own history for other
# tokens it likely launched. Higher = more thorough, more RPC calls.
RUG_CHECK_DEPLOYER_LOOKBACK_PAGES=5

# A token transfer INTO the deployer of at least this size is treated as
# "this looks like an initial supply mint" when scanning for other tokens
# the deployer has launched. Meme coin initial supplies are typically in
# the millions/billions, so this default is deliberately low to catch
# most of them; raise it if you're seeing false positives.
RUG_CHECK_MIN_INITIAL_MINT_AMOUNT=1000000

# A previously-launched token found in a deployer's history with less
# than this much USD liquidity today is counted as "likely abandoned" —
# the classic serial-rug-deployer signal.
RUG_CHECK_ABANDONED_LIQUIDITY_USD=500

# How often the research module runs, in minutes. Separate from
# DISCOVERY_INTERVAL_MINUTES above — different data sources, can run on
# a different cadence.
RESEARCH_INTERVAL_MINUTES=15

# ---------- Paper trading ----------
# This is what actually answers "would this make money" — every signal
# opens a simulated position automatically, no real funds ever move.

# Virtual notional per trade, in the trade's own quote currency (USD for
# tokens, SOL for NFTs — these are never mixed together).
PAPER_POSITION_SIZE=100

# Exit rules. A trade closes on whichever hits first.
PAPER_STOP_LOSS_PCT=20
PAPER_TAKE_PROFIT_PCT=50
PAPER_MAX_HOLD_HOURS=48

# Modeled costs, applied per side (entry AND exit each pay these) so
# performance isn't overstated. These are estimates — real DEX fees and
# slippage vary by venue and trade size; adjust if you have better
# numbers for the tokens you're actually seeing.
PAPER_FEE_PCT=1
PAPER_SLIPPAGE_PCT=2

# How often open trades are checked against stop/target/time-limit, and
# how often the Telegram performance digest goes out.
PAPER_CHECK_INTERVAL_MINUTES=10
PAPER_DIGEST_INTERVAL_HOURS=24

# ---------- Wallet credibility scoring ----------
# How many closed paper trades a wallet needs before its performance
# score counts at full confidence (fewer trades = the score is
# discounted proportionally, not zeroed out).
WALLET_SCORE_MIN_TRADES=10

# How often the Telegram wallet-credibility digest goes out, in hours.
# Weekly by default — scores depend on paper trades having closed, which
# takes time, so there's little value in running this more often early on.
WALLET_SCORE_INTERVAL_HOURS=168